# Local default: data/coachline.sqlite3
COACHLINE_DATABASE_PATH=data/coachline.sqlite3

# Production alternative; when set, this takes precedence over the path.
# COACHLINE_DATABASE_URL=postgresql://coachline:password@db:5432/coachline

# Runtime and privacy-safe request logging.
PORT=8000
COACHLINE_LOG_LEVEL=INFO

# Single-owner Bearer credential for every private API. Use a long random value.
COACHLINE_ADMIN_TOKEN=replace-with-a-long-random-value

# Twilio credentials. Never commit real values.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-primary-auth-token
TWILIO_FROM_NUMBER=+15555550100

# Must exactly match the public URL configured for the Twilio phone number.
TWILIO_WEBHOOK_URL=https://example.com/webhooks/twilio/sms

# OpenAI Responses API. Never commit a real key.
OPENAI_API_KEY=replace-with-project-api-key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
